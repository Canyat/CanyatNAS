[Unit]
Description=CanyatNAS Dashboard & Docker Manager Service
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/canyat-nas
ExecStart=/usr/bin/node backend/dist/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5678
Environment=DATA_DIR=/opt/canyat-nas/data

[Install]
WantedBy=multi-user.target
